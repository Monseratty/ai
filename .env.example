AIO_ENVIRONMENT=local
AIO_DATABASE_URL=postgresql+asyncpg://orchestrator:orchestrator@localhost:5432/orchestrator
AIO_REDIS_URL=redis://localhost:6379/0
AIO_SANDBOX_IMAGE=python:3.12-slim
AIO_SANDBOX_TIMEOUT_SECONDS=300
AIO_SANDBOX_MEMORY=1g
AIO_SANDBOX_CPUS=1.0
AIO_SANDBOX_WORKSPACE_ROOT=.sandboxes
AIO_AGENT_BACKEND=fake
AIO_OPENAI_MODEL=gpt-5.2
# Optional per-agent model overrides:
# AIO_PLANNER_MODEL=gpt-5.2
# AIO_CODER_MODEL=gpt-5.2
# AIO_TESTER_MODEL=gpt-5.2
# AIO_REVIEWER_MODEL=gpt-5.2
AIO_ARTIFACT_ROOT=.artifacts
AIO_REPO_PATH=.
AIO_BRANCH_PREFIX=codex/
# Pull request provider: local or github
AIO_PULL_REQUEST_PROVIDER=local
# AIO_GITHUB_REPOSITORY=owner/name
# AIO_GITHUB_TOKEN=ghp_...
# Optional API auth. If set, clients must send Authorization: Bearer <token>
# AIO_API_TOKEN=change-me
# API rate limiting: memory for single-process local use, redis for multi-instance deployments.
AIO_API_RATE_LIMIT_BACKEND=memory
AIO_API_RATE_LIMIT_PER_MINUTE=60
AIO_API_CORS_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173"]
AIO_TELEMETRY_BACKEND=logging
